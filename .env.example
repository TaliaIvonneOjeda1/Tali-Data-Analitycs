# Copiar a .env y completar. Nunca commitear .env.
# Si este archivo no existe, src.config también intenta el .env del directorio padre.
ANTHROPIC_API_KEY=

# Modelo por defecto
ANTHROPIC_MODEL=claude-haiku-5-5

# Tope del agent loop
AGENT_MAX_ITERATIONS=16

# Modo producto / API
ANALISTA_API_TOKEN=dev-token-cambiar
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_PER_MIN=30
PRODUCT_MAX_WALL_S=180
PRODUCT_MAX_USD=0.75
PRODUCT_MAX_ITER=12
DUCKDB_QUERY_TIMEOUT_S=30
DUCKDB_MAX_ROWS=200

# Opcional: esfuerzo de thinking (API Anthropic)
# ANTHROPIC_EFFORT=medium

